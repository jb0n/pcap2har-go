            "mimeType": "text/html; charset=UTF-8",
            "size": 1212,
            "text": "\u003c!DOCTYPE html\u003e\n\u003chtml lang=\"en\"\u003e\n  \u003chead\u003e\n    \u003cmeta charset=\"utf-8\"\u003e\n    \u003ctitle\u003eFish and Chips\u003c/title\u003e\n    \u003clink rel=\"stylesheet\" href=\"/site.css\"\u003e\n    \u003clink rel=\"stylesheet\" href=\"/ext/jquery-ui-1.12.1/jquery-ui.min.css\"\u003e\n    \u003cscript src=\"/ext/jquery-3.3.1.min.js\"\u003e\u003c/script\u003e\n    \u003cscript src=\"/ext/jquery-ui-1.12.1/jquery-ui.min.js\"\u003e\u003c/script\u003e\n\n  \u003c/head\u003e\n  \u003cbody\u003e\n    \u003cscript src=\"/js/fish-and-chips.js\"\u003e\u003c/script\u003e\n\u003ctable class=\"orders\"\u003e\n    \u003ctr\u003e\n        \u003cth\u003eName\u003c/th\u003e\n        \u003cth\u003eOrder\u003c/th\u003e\n    \u003c/tr\u003e\n    \n    \u003ctr class=\"line\" data-id=\"2\"\u003e\n        \u003ctd class=\"name\"\u003ename\u003c/td\u003e\n        \u003ctd class=\"food\"\u003etest\u003c/td\u003e\n    \u003c/tr\u003e\n    \n\u003c/table\u003e\n\u003cform method=\"POST\"\u003e\u003cinput type=\"hidden\" name=\"SEC\" value=\"a012bc44ab86be07\" /\u003e\n    \u003ctextarea name=\"food\"\u003e\u003c/textarea\u003e\n    \u003cinput type=\"submit\" value=\"Order\"\u003e\n\u003c/form\u003e\n\u003cdiv class=\"dialog\"\u003e\n    \u003cform method=\"POST\"\u003e\u003cinput type=\"hidden\" name=\"SEC\" value=\"a012bc44ab86be07\" /\u003e\n        \u003clabel for=\"food\"\u003eOrder\u003c/label\u003e\n        \u003ctextarea id=\"food\" name=\"food\"\u003e\u003c/textarea\u003e\n\n        \u003clabel for=\"user_id\"\u003eUser\u003c/label\u003e\n        \u003cselect id=\"user_id\" name=\"user_id\"\u003e\n            \n            \u003coption value=\"1\"\u003ename\u003c/option\u003e\n            \n        \u003c/select\u003e\n    \u003c/form\u003e\n\u003c/div\u003e\n\n  \u003c/body\u003e\n\u003c/html\u003e\n\n\n",
